# Copy to .env.local and fill in from Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
# Leave VITE_FIREBASE_API_KEY empty to run in demo mode (data saved on this device only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Voice clips (`npm run voice`). Only used by the script on your computer;
# never sent to the app. Get the key at elevenlabs.io → Profile → API keys,
# and a voice id from `npm run voice -- --list-voices`.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: a different voice for Hebrew, or other models.
ELEVENLABS_VOICE_ID_HE=
ELEVENLABS_MODEL_EN=eleven_multilingual_v2
ELEVENLABS_MODEL_HE=eleven_v3

# Firebase App Check with reCAPTCHA Enterprise (public site key).
# Leave empty to run without App Check. See README → App Check.
VITE_RECAPTCHA_SITE_KEY=

# Set to "true" to talk to local emulators (firebase emulators:start).
VITE_USE_FIREBASE_EMULATORS=false
