{
  "name": "dragon-brush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "dev:phone": "vite --host --mode https",
    "dev:demo": "vite --mode demo",
    "dev:emulator": "vite --mode emulator",
    "voice": "node --env-file-if-exists=.env.local scripts/generate-voice.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-dragon-brush",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dragon-brush \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "tsc -b",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.18",
    "firebase": "11.0.2",
    "i18next": "23.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.3",
    "react-router-dom": "6.28.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "firebase-tools": "^13.24.1",
    "qrcode": "^1.5.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
