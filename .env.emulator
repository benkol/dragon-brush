# `npm run dev:emulator`: talk to local Firebase emulators with a throwaway
# demo project, never the real one. Start them with `npm run emulators`.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-dragon-brush.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-dragon-brush
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_FIREBASE_EMULATORS=true
